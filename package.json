{
  "name": "reading-time-chrome-extension",
  "description": "Displays approximate reading time for articles and web pages",
  "private": true,
  "scripts": {
    "build": "node esbuild.mjs",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "lint-staged": {
    "*.{css,html,js,json,jsx,md,mjs,ts,tsx,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
